# Cine Space settings
# Save this file as ".env" (with the dot, no .txt) in the project root,
# next to server.js and package.json.

# Paste your TMDB "API Read Access Token" after the = sign (no quotes, no spaces).
# Get it at https://www.themoviedb.org/settings/api
TMDB_TOKEN=paste_your_tmdb_read_access_token_here
# Port the app runs on (open http://localhost:3000)
PORT=3000

# Country used for "where to watch" (PH = Philippines)
WATCH_REGION=PH