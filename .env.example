PORT=3000
# Secret used to sign login tokens. Leave empty and a random one is generated and saved in data/.session-secret
SESSION_SECRET=
# TMDB read access token (https://www.themoviedb.org/settings/api). Enables movie search, ratings, collections and
# "where to watch" for movies and TV. Without it, movies fall back to iTunes and streaming info is limited.
TMDB_TOKEN=
# Country used for "where to watch" until the user picks one in the app (two-letter code)
WATCH_REGION=PH
# Optional tuning (milliseconds)
# UPSTREAM_TIMEOUT_MS=6000
# SEARCH_DEADLINE_MS=10000
